# ====================================
# PKU 教学网 Cookie 认证
# 登录 course.pku.edu.cn → F12 → 应用程序 → Cookie
# ====================================

# course.pku.edu.cn 域
COOKIE_JSESSIONID=你的JSESSIONID
COOKIE_s_session_id=你的s_session_id

# .pku.edu.cn 域
COOKIE_JWTUser=你的JWTUser（URL编码的JSON）

# .pku.edu.cn 域 (HLS AES 解密密钥认证)
COOKIE__token=你的_token

# ====================================
# AI API Keys
# ====================================

# 阿里云 DashScope (Qwen 视觉模型, 课件分析)
# https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=sk-xxxxxxxx

# DeepSeek API (文本总结, 转录后处理)
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxx

# Whisper 设备 (可选: cpu / cuda)
WHISPER_DEVICE=cpu

# ====================================
# 本地路径
# ====================================

# Zotero 数据库路径 (非默认位置需要指定)
# 默认会从 %APPDATA%/Zotero 自动查找，不设也行
# 如果 Zotero 数据在其他盘（如 F:\文献\zotero.sqlite），取消注释并修改：
# ZOTERO_DB_PATH=F:/文献/zotero.sqlite
